# Normalisasi akhir baris supaya berkas tidak "berubah semua" saat dibuka
# di Windows vs Linux/macOS.
* text=auto eol=lf

# Berkas biner: jangan disentuh.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.jar binary
*.woff binary
*.woff2 binary

# Skrip Gradle harus tetap berakhiran LF dan punya bit executable di
# Linux/macOS, kalau tidak `./gradlew` gagal dijalankan.
src-tauri/gen/android/gradlew text eol=lf
